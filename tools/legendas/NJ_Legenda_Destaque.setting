				Input5 = InstanceInput { SourceOp = "Texto", Source = "Center", Name = "Posicao", },
				Input6 = InstanceInput { SourceOp = "Texto", Source = "Red1", Name = "Cor do texto", ControlGroup = 1, },
				Input7 = InstanceInput { SourceOp = "Texto", Source = "Green1", ControlGroup = 1, },
				Input8 = InstanceInput { SourceOp = "Texto", Source = "Blue1", ControlGroup = 1, },
				Input9 = InstanceInput { SourceOp = "Texto", Source = "Red3", Name = "Cor da caixa", ControlGroup = 2, },
				Input10 = InstanceInput { SourceOp = "Texto", Source = "Green3", ControlGroup = 2, },
				Input11 = InstanceInput { SourceOp = "Texto", Source = "Blue3", ControlGroup = 2, },
			},
			Outputs = {
