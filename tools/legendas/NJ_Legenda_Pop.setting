				Input8 = InstanceInput { SourceOp = "Texto", Source = "Blue1", ControlGroup = 1, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Anim", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
		Texto = TextPlus {
			CtrlWZoom = false,
			Inputs = {
