		Anim = Transform {
			CtrlWZoom = false,
			Inputs = {
				Size = Input { Value = 1, Expression = "((1-(1-min(time,7)/7)^3) + 0.12*sin(min(time,7)/7*3.14159)) * min(1, max(0, (comp.RenderEnd - time)/5))", },
				Input = Input { SourceOp = "Texto", Source = "Output", },
			},
			ViewInfo = OperatorInfo { Pos = { 110, 0 } },
